apiVersion: v1
kind: Secret
metadata:
  name: fraud-pipeline-secrets
type: Opaque
stringData:
  # ── ClickHouse credentials ─────────────────────────────────────────────────
  # Copy this file to k8s/secrets.yaml and fill in real values.
  # k8s/secrets.yaml is gitignored — never commit actual credentials.
  CLICKHOUSE_USER: "REPLACE_ME"
  CLICKHOUSE_PASSWORD: "REPLACE_ME"
  # ── Grafana credentials ─────────────────────────────────────────────────────
  GRAFANA_ADMIN_PASSWORD: "REPLACE_ME"
  # ── ML model administration ─────────────────────────────────────────────────
  # Required by POST /models/{version}/activate when set in the ml-server pod.
  MODEL_ADMIN_API_KEY: "REPLACE_ME"
