# =================================================================
# .env.example — Template cho .env
# Copy file này thành .env và điền giá trị của bạn:
#   cp .env.example .env
#
# Dùng bởi:
#   - scripts/csv_replayer.py  (kết nối Kafka từ host)
#   - ml/model_server.py       (cổng và ngưỡng model khi chạy local)
#   - PipelineConfig.java      (chỉ khi chạy Flink trực tiếp trên host)
#
# LƯU Ý: Flink/ClickHouse chạy trong K8s đọc env vars từ flink.yaml,
#         không đọc file này.
# =================================================================

# ----------------------------
# Ports cho các dịch vụ (Dùng khi port-forward về localhost)
# ----------------------------
GRAFANA_PORT=30000
PROMETHEUS_PORT=30090
FLINK_WEB_PORT=30081
CLICKHOUSE_PORT=30123
MODEL_SERVER_PORT=30001

# ----------------------------
# Kafka local listener (kết nối qua port-forward về localhost)
# ----------------------------
KAFKA_PORT=30093
KAFKA_BOOTSTRAP=localhost:30093

# ----------------------------
# Kafka topic (csv_replayer.py)
# ----------------------------
TRANSACTIONS_TOPIC=transactions

# ----------------------------
# Kết nối ClickHouse (Flink local / kiểm tra thủ công)
# ----------------------------
CLICKHOUSE_URL=jdbc:clickhouse://localhost:30123/default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_password_here

# ----------------------------
# Flink (chỉ hiệu quả khi chạy Flink trực tiếp trên host)
# ----------------------------
CHECKPOINT_STORAGE=file:///tmp/flink-checkpoints/fraud-pipeline

# ----------------------------
# ML Model Server
# ----------------------------
ML_THRESHOLD=0.5
